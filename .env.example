# Copy to .env for local development. Never commit real credentials.
APP_NAME=repo-ci-debugger
ENVIRONMENT=production
LOG_LEVEL=INFO

# Required - PostgreSQL connection string from Render (or another managed provider).
DATABASE_URL=postgresql://username:password@your-render-postgres-host:5432/your_database_name
DATABASE_SSL=false

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# CORS
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Server
PORT=10000

# GitHub App / Webhook (Phase 2)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_ID=
GITHUB_API_BASE_URL=https://api.github.com

# Worker configuration
WORKER_MAX_RETRIES=5
WORKER_RETRY_DELAY_SECONDS=60

# LLM Provider (Phase 3)
LLM_PROVIDER=openrouter
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openrouter.ai/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# Multi-Agent / CI (Phase 4)
WORKFLOW_MAX_AGENTS=6
WORKFLOW_MAX_REPLANS=2
WORKFLOW_MAX_RETRIES=3
WORKFLOW_MAX_PARALLEL=3
WORKFLOW_MAX_WALL_CLOCK_SECONDS=600
WORKFLOW_MAX_LLM_CALLS=20
WORKFLOW_MAX_CONTEXT_SIZE_BYTES=1000000

# Patch Generation & Sandbox (Phase 5)
PATCH_MAX_FILES=5
PATCH_MAX_ADDITIONS=500
PATCH_MAX_DELETIONS=500
PATCH_MAX_GENERATION_ATTEMPTS=3
PATCH_MAX_VERIFICATION_SECONDS=300
SANDBOX_ENABLED=false
SANDBOX_NETWORK_DISABLED=true

# Evaluation & Observability (Phase 6)
EVAL_DATASET_PATH=
METRICS_ENABLED=true
LOG_REDACTION_ENABLED=true
COST_BUDGET_MAX_LLM_CALLS=20
COST_BUDGET_MAX_TOKENS=100000
COST_BUDGET_MAX_WALL_SECONDS=600
